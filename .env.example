# Copiez ce fichier en `.env` et adaptez-le. Toutes les variables sont optionnelles.

# --- Serveur ---
ALLBUDY_HOST=0.0.0.0
ALLBUDY_PORT=8088
# Prefixe si AllBudy est servi derriere un reverse proxy (ex: /allbudy)
# ALLBUDY_BASE_PATH=

# --- Donnees ---
ALLBUDY_DATA_DIR=./data
ALLBUDY_MAX_UPLOAD_MB=512

# --- Securite ---
# Laissez vide: une cle est generee et conservee dans data/secret.key
# ALLBUDY_SECRET_KEY=
# Desactivee par defaut: AllBudy est concu pour un reseau local deja
# cloisonne, sans ecran de connexion. Ne l'activez que si l'instance est
# exposee au-dela de ce reseau (l'interface fournie n'a plus de page de
# connexion: prevoyez un reverse proxy ou un VPN en plus).
# ALLBUDY_AUTH_ENABLED=true
# ALLBUDY_ADMIN_USERNAME=admin
# ALLBUDY_ADMIN_PASSWORD=allbudy
ALLBUDY_SESSION_TTL_HOURS=336

# --- Parc ---
# Intervalle d'interrogation des imprimantes (secondes)
ALLBUDY_POLL_INTERVAL=2.0
ALLBUDY_RECONNECT_DELAY=5.0
# Intervalle du dispatcher de la file d'attente (secondes)
ALLBUDY_SCHEDULER_INTERVAL=5.0

# --- Decouverte reseau ---
ALLBUDY_DISCOVERY_PORTS=7125,9999
ALLBUDY_DISCOVERY_TIMEOUT=1.0

# --- Divers ---
ALLBUDY_LOG_LEVEL=INFO
# Imprimantes simulees creees au premier demarrage (demo sans materiel)
ALLBUDY_DEMO_PRINTERS=0
